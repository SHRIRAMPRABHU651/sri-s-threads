# Copy to .env.local and change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-string
# Default WhatsApp number for orders (country code + number, digits only). Editable later in Admin > Settings.
WHATSAPP_NUMBER=919999999999
