# Copy to .env.local for local development. On Vercel, add the same names under Project → Settings → Environment Variables.

# MongoDB Atlas connection string (free M0 cluster). Data AND uploaded images are stored here.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sris-threads

# Admin login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Long random string that signs the admin session cookie, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-with-a-long-random-string

# First-run default for the WhatsApp order number (country code + number, digits only). Editable later in Admin → Settings.
WHATSAPP_NUMBER=919999999999

# Cloudinary (free) — product photo hosting. Leave empty to keep storing photos in MongoDB.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# ...or the single-variable form: CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>
# CLOUDINARY_FOLDER=sris-threads   # live/preview/dev images go in <folder>/production|preview|development

# Optional: your custom domain, used in the sitemap / link previews
# NEXT_PUBLIC_SITE_URL=https://www.example.com
